generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  active
  inactive

  @@map("account_status")
}

enum UserRole {
  banned
  user
  superuser
  admin
  owner

  @@map("user_role")
}

enum ProposalStatus {
  pending
  approved
  rejected

  @@map("proposal_status")
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  username        String        @unique @db.VarChar(50)
  email           String        @unique
  passwordHash    String        @map("password_hash")
  emailVerifiedAt DateTime?     @map("email_verified_at") @db.Timestamptz(6)
  status          AccountStatus @default(active)
  role            UserRole      @default(user)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  stats             UserStats?
  streak            UserStreak?
  progress          UserNodeProgress[]
  submissions       ChallengeSubmission[]
  sessions          Session[]
  attempts          ChallengeAttempt[]
  verifications     EmailVerification[]
  proposalsAuthored ProblemProposal[] @relation("ProposalAuthor")
  proposalsReviewed ProblemProposal[] @relation("ProposalReviewer")

  @@map("users")
}

model EmailVerification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

model Session {
  tokenHash String   @id @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model UserStats {
  userId                String @id @map("user_id") @db.Uuid
  overallElo            Int    @default(1200) @map("overall_elo")
  debuggingElo          Int    @default(1200) @map("debugging_elo")
  securityElo           Int    @default(1200) @map("security_elo")
  comprehensionElo      Int    @default(1200) @map("comprehension_elo")
  performanceElo        Int    @default(1200) @map("performance_elo")
  architectureElo       Int    @default(1200) @map("architecture_elo")
  mlElo                 Int    @default(1200) @map("ml_elo")
  totalChallengesSolved Int    @default(0) @map("total_challenges_solved")
  user                  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model UserStreak {
  userId            String    @id @map("user_id") @db.Uuid
  currentStreak     Int       @default(0) @map("current_streak")
  longestStreak     Int       @default(0) @map("longest_streak")
  lastActiveDate    DateTime? @map("last_active_date") @db.Date
  lastFreezeUsedOn  DateTime? @map("last_freeze_used_on") @db.Date
  streakFreezesLeft Int       @default(2) @map("streak_freezes_left")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_streaks")
}

model SkillNode {
  id                  String   @id @db.VarChar(100)
  title               String
  category            String   @db.VarChar(50)
  prerequisiteNodeIds String[] @map("prerequisite_node_ids")
  difficultyLevel     Int      @default(1) @map("difficulty_level")
  summary             String
  showInGraph         Boolean  @default(true) @map("show_in_graph")
  lessonNumber        Int?     @unique @map("lesson_number")
  kind                String   @default("patch") @db.VarChar(20)
  label               String   @default("") @db.VarChar(40)
  active              Boolean  @default(true)
  positionX           Float?   @map("position_x")
  positionY           Float?   @map("position_y")
  payload             Json?

  progress    UserNodeProgress[]
  submissions ChallengeSubmission[]

  @@map("skill_nodes")
}

model UserNodeProgress {
  userId      String    @map("user_id") @db.Uuid
  nodeId      String    @map("node_id") @db.VarChar(100)
  status      String    @default("in_progress") @db.VarChar(20)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  bestScore   Int       @default(0) @map("best_score")
  attempts    Int       @default(0)

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  node SkillNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([userId, nodeId])
  @@map("user_node_progress")
}

model ChallengeSubmission {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  nodeId            String   @map("node_id") @db.VarChar(100)
  codeSubmitted     String   @map("code_submitted") @db.Text
  passedAllTests    Boolean  @map("passed_all_tests")
  executionTimeMs   Int?     @map("execution_time_ms")
  optimalPatchScore Int?     @map("optimal_patch_score")
  timeToFixMs       Int?     @map("time_to_fix_ms")
  category          String   @db.VarChar(50)
  hintsUsed         Int      @default(0) @map("hints_used")
  breakdown         Json?
  submittedAt       DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  node SkillNode @relation(fields: [nodeId], references: [id])

  @@index([userId, submittedAt])
  @@map("challenge_submissions")
}

model ChallengeAttempt {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  nodeId     String    @map("node_id") @db.VarChar(100)
  mode       String    @db.VarChar(20)
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  deadlineAt DateTime? @map("deadline_at") @db.Timestamptz(6)
  hintsUsed  Int       @default(0) @map("hints_used")
  closedAt   DateTime? @map("closed_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, nodeId])
  @@map("challenge_attempts")
}

model ProblemProposal {
  id             String         @id @default(uuid()) @db.Uuid
  authorId       String         @map("author_id") @db.Uuid
  status         ProposalStatus @default(pending)
  label          String         @db.VarChar(40)
  title          String         @db.VarChar(120)
  description    String         @db.Text
  category       String         @db.VarChar(50)
  kind           String         @db.VarChar(20)
  difficulty     Int
  showInGraph    Boolean        @default(true) @map("show_in_graph")
  prereqNumbers  Int[]          @default([]) @map("prereq_numbers")
  payload        Json
  reviewNote     String?        @map("review_note") @db.Text
  reviewerId     String?        @map("reviewer_id") @db.Uuid
  reviewedAt     DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  lessonNumber   Int?           @unique @map("lesson_number")
  nodeId         String?        @unique @map("node_id") @db.VarChar(100)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  author   User  @relation("ProposalAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ProposalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([authorId, status])
  @@index([status, createdAt])
  @@map("problem_proposals")
}
